{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Harvest",
  "colors": {
    "primary": "#B8962E",
    "light": "#D4B155",
    "dark": "#8C701F"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://theharvest.app",
        "label": "Open Harvest"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start free",
      "href": "https://theharvest.site"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://theharvest.site"
    }
  },
  "description": "Harvest is the digital foundation for churches and ministries — one place for your people, your content, your giving and your Sunday.",
  "appearance": {
    "default": "light"
  },
  "seo": {
    "indexing": "navigable"
  }
}
